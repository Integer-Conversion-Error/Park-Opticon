# Server Configuration
PORT=8080
ENV=development
API_VERSION=v1

# Database Configuration (PostgreSQL with PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=parkopticon
DB_PASSWORD=your_secure_password_here
DB_NAME=parkopticon_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=parkopticon-photos
S3_PHOTO_MAX_SIZE_MB=5

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Background Worker Configuration
ALERT_CHECK_INTERVAL=30s
SPOT_EXPIRY_CHECK_INTERVAL=5m

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REPORT_SPOT_PER_HOUR=10
RATE_LIMIT_REPORT_ENFORCEMENT_PER_HOUR=20

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
