# Server Configuration
PORT=8080
ENV=development
API_VERSION=v1
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

# Production Docker publishes the API only on this interface by default. Put a
# TLS reverse proxy in front of it; do not expose OAuth credentials over HTTP.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Database Configuration (PostgreSQL with PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=parkopticon
DB_PASSWORD=your_secure_password_here
DB_NAME=parkopticon_db
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=5s
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
# Set true only when the database is on the same private host/Compose network.
# Leave false for any remote database, which must use TLS (verify-full).
DB_ALLOW_INSECURE_LOCAL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
MFA_ENCRYPTION_KEY=generate-a-long-random-secret
ADMIN_MFA_STEP_UP=10m

# External sign-in verification. These are public OAuth client IDs, not client
# secrets. List every issued client ID that is allowed to mint a token for the
# mobile app (comma-separated). The Apple audience is normally the iOS bundle
# identifier, com.parkopticon.app.
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Keep this only on the backend. It is the secret for the Google Web OAuth
# client used to exchange one-time native server-auth codes.
GOOGLE_OAUTH_CLIENT_SECRET=your-google-web-client-secret
APPLE_OAUTH_CLIENT_IDS=com.parkopticon.app
OAUTH_CHALLENGE_EXPIRY=5m
OAUTH_LINK_REAUTH_EXPIRY=5m
OAUTH_JWKS_CACHE_TTL=6h

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=parkopticon-photos
S3_PHOTO_MAX_SIZE_MB=5

# Reserved Firebase configuration (not used by the current notification path)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Expo Push Service access token. Required for production push delivery.
EXPO_PUSH_ACCESS_TOKEN=

# Background Worker Configuration
# ALERT_CHECK_INTERVAL is a compatibility fallback; the queue worker uses the
# settings below and should run as a separate process/container.
ALERT_DISPATCH_INTERVAL=60s
ALERT_DISPATCH_BATCH_SIZE=25
PUSH_DELIVERY_BATCH_SIZE=100
WORKER_JOB_LEASE=2m
ENFORCEMENT_ALERT_RADIUS_METERS=1000
SPOT_EXPIRY_CHECK_INTERVAL=5m

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_ADMIN_PER_MINUTE=120

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Backup configuration belongs in a root-owned file outside the repository
# (for example /etc/parkopticon/backup.env), not the application .env file.
# BACKUP_DIR=/opt/parkopticon/backups
# BACKUP_OFFSITE_DIR=/mnt/offsite/parkopticon
# BACKUP_AGE_RECIPIENT=age1your_public_recipient_key
# BACKUP_RETENTION_DAYS=30
