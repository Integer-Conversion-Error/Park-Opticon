# Use the API root, without /api/v1. Production must use HTTPS.
EXPO_PUBLIC_API_URL=https://api.example.com

# Required by Google Maps in standalone Android APKs (Expo Go supplies its own).
# Restrict to Maps SDK for Android, com.parkopticon.app, and the APK signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Expo project ID used to issue device push tokens in standalone builds.
EXPO_PUBLIC_EXPO_PROJECT_ID=69554c64-4de8-40e8-97ee-5d6f3e455c8b

# Google Sign-In uses a public OAuth web client ID to request a server
# authorization code. Never add a Google client secret to the mobile app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional for iOS builds: the reversed iOS OAuth client ID, supplied to the
# Google Expo config plugin at build time (for example, com.googleusercontent.apps.123456789-example).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
