{
  "expo": {
    "name": "Parkopticon",
    "slug": "parkopticon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2196F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkopticon.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Parkopticon needs your location to show nearby parking spots and enforcement alerts.",
        "NSCameraUsageDescription": "Parkopticon needs camera access to let you take photos of parking spots."
      },
      "newArchEnabled": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2196F3"
      },
      "package": "com.parkopticon.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "PASTE_YOUR_API_KEY_HERE"
        }
      },
      "newArchEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Parkopticon to use your location to show nearby parking spots."
        }
      ]
    ]
  }
}
